  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID77",
   "SecondaryAttribute": "comp_baserate",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<b>1.</b> Out of 100 people in this data, about how many reoffended within two years?",
    "QuestionType": "MC",
    "Selector": "SAVR",
    "SubSelector": "TX",
    "Choices": {
     "1": {
      "Display": "About 10 out of 100"
     },
     "2": {
      "Display": "About X out of 100"
     },
     "3": {
      "Display": "About 90 out of 100"
     }
    },
    "ChoiceOrder": [
     "1",
     "2",
     "3"
    ],
    "Validation": {
