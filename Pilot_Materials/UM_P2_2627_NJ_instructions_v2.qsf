   }
  },
  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID72",
   "SecondaryAttribute": "instr4",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<h3>How each case works</h3><p>Each case has three steps:</p><ol><li>You read the profile and make your <b>first prediction</b>.</li><li>You see the AI model's prediction and its chart.</li><li>You make your <b>final prediction</b>. You can keep or change your first prediction.</li></ol><p>You cannot go back to earlier pages.</p>",
    "QuestionType": "DB",
    "Selector": "TB",
    "QuestionID": "QID72",
    "ChoiceOrder": [],
    "Validation": {
     "Settings": {
      "Type": "None"
     }
    },
    "NextChoiceId": 4,
    "NextAnswerId": 1,
    "Language": [],
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Configuration": {
     "QuestionDescriptionOption": "UseText"
    },
    "QuestionDescription": "instr4",
    "GradingData": [],
    "DataExportTag": "instr4"
   }
  },
