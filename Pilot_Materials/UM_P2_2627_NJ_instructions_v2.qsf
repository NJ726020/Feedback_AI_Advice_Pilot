  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID66",
   "SecondaryAttribute": "instr1",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<h3>Welcome</h3><p>In this study, you will see information about real people who were arrested in Florida (USA) in 2013 or 2014. In legal terms, these people are called <b>defendants</b>: people accused of a crime.</p><p>For each person, you will predict: <b>Was this person arrested again within two years?</b></p><p>The next pages explain the task. Please read them carefully. Afterwards, you will answer three short questions about them.</p>",
    "QuestionType": "DB",
    "Selector": "TB",
    "QuestionID": "QID66",
    "ChoiceOrder": [],
    "Validation": {
     "Settings": {
      "Type": "None"
     }
    },
    "NextChoiceId": 4,
    "NextAnswerId": 1,
    "Language": [],
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Configuration": {
     "QuestionDescriptionOption": "UseText"
    },
    "QuestionDescription": "instr1",
    "GradingData": [],
    "DataExportTag": "instr1"
   }
  },
  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID67",
   "SecondaryAttribute": "t_instr1",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "Timing",
    "DefaultChoices": false,
    "QuestionType": "Timing",
    "Selector": "PageTimer",
    "Configuration": {
     "QuestionDescriptionOption": "UseText",
     "MinSeconds": "0",
     "MaxSeconds": "0"
    },
    "Choices": {
     "1": {
      "Display": "First Click"
     },
     "2": {
      "Display": "Last Click"
     },
     "3": {
      "Display": "Page Submit"
     },
     "4": {
      "Display": "Click Count"
     }
    },
    "QuestionID": "QID67",
    "NextChoiceId": 5,
    "NextAnswerId": 1,
    "Language": [],
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "QuestionDescription": "t_instr1",
