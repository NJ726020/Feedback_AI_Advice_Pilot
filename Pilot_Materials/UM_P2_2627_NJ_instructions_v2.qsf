   }
  },
  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID68",
   "SecondaryAttribute": "instr2",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<h3>What does \"reoffending\" mean?</h3><p><b>Reoffending</b> means that the person was <b>arrested again for a new offense</b> within two years. The new offense can be a different type of crime than the first one, and it can be minor or serious.</p><p>Out of every <b>100 people</b> in this data, about <b>X reoffended</b> within two years.</p>",
    "QuestionType": "DB",
    "Selector": "TB",
    "QuestionID": "QID68",
    "ChoiceOrder": [],
    "Validation": {
     "Settings": {
      "Type": "None"
     }
    },
    "NextChoiceId": 4,
    "NextAnswerId": 1,
    "Language": [],
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Configuration": {
     "QuestionDescriptionOption": "UseText"
    },
    "QuestionDescription": "instr2",
    "GradingData": [],
    "DataExportTag": "instr2"
   }
  },
  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID69",
   "SecondaryAttribute": "t_instr2",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "Timing",
    "DefaultChoices": false,
    "QuestionType": "Timing",
    "Selector": "PageTimer",
    "Configuration": {
     "QuestionDescriptionOption": "UseText",
     "MinSeconds": "0",
     "MaxSeconds": "0"
    },
    "Choices": {
     "1": {
      "Display": "First Click"
     },
     "2": {
      "Display": "Last Click"
     },
     "3": {
      "Display": "Page Submit"
     },
     "4": {
      "Display": "Click Count"
     }
    },
    "QuestionID": "QID69",
    "NextChoiceId": 5,
    "NextAnswerId": 1,
    "Language": [],
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "QuestionDescription": "t_instr2",
    "GradingData": [],
    "DataExportTag": "t_instr2"
   }
  },
  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID70",
   "SecondaryAttribute": "instr3",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<h3>The AI model</h3><p>To help you, you will see the prediction of an <b>AI model</b>. The model learned from thousands of earlier cases like these.</p><p>The model is right for about <b>X out of 10</b> people. So it is sometimes wrong.</p><p>The model also shows a chart that explains its prediction. Here is an example:</p><div style=\"text-align:center;\"><img src=\"${e://Field/img_example_explanation}\" alt=\"Example chart\" style=\"max-width:100%; height:auto;\"></div><ul><li><b style=\"color:#C8102E;\">Red bars</b>: this information makes reoffending <b>more likely</b>.</li><li><b style=\"color:#1F4FD1;\">Blue bars</b>: this information makes reoffending <b>less likely</b>.</li><li><b style=\"color:#6B6B6B;\">Grey bar (base rate)</b>: the starting point, a low-risk person (a 31-year-old woman, arrested for a minor offense, with no earlier offenses).</li><li>Longer bars mean a bigger effect.</li></ul><p><b>Words you will see in the profiles:</b></p><table style=\"border-collapse:collapse;\" cellpadding=\"6\"><tr><td style=\"border-bottom:1px solid #ccc;\"><b>Charge</b></td><td style=\"border-bottom:1px solid #ccc;\">The crime the person was accused of when arrested</td></tr><tr><td style=\"border-bottom:1px solid #ccc;\"><b>Felony</b></td><td style=\"border-bottom:1px solid #ccc;\">A serious crime (in the USA, it can lead to more than one year in prison)</td></tr><tr><td style=\"border-bottom:1px solid #ccc;\"><b>Misdemeanor</b></td><td style=\"border-bottom:1px solid #ccc;\">A less serious crime (in the USA, at most one year in jail)</td></tr><tr><td style=\"border-bottom:1px solid #ccc;\"><b>Prior count</b></td><td style=\"border-bottom:1px solid #ccc;\">How many earlier offenses the person has on their record as an adult</td></tr><tr><td><b>Days in custody</b></td><td>How many days the person was held in jail after this arrest</td></tr></table>",
    "QuestionType": "DB",
    "Selector": "TB",
    "QuestionID": "QID70",
    "ChoiceOrder": [],
    "Validation": {
     "Settings": {
      "Type": "None"
     }
    },
    "NextChoiceId": 4,
    "NextAnswerId": 1,
    "Language": [],
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Configuration": {
     "QuestionDescriptionOption": "UseText"
    },
    "QuestionDescription": "instr3",
    "GradingData": [],
    "DataExportTag": "instr3"
   }
  },
  {
