  {
   "SurveyID": "SV_57SmXSpbIXf7miq",
   "Element": "SQ",
   "PrimaryAttribute": "QID83",
   "SecondaryAttribute": "reread_notice_2",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<p style=\"border:2px solid #C8102E; padding:10px;\"><b>Not all of your answers were correct.</b> Please read the instructions again carefully. You will then answer the questions once more.</p>",
    "QuestionType": "DB",
