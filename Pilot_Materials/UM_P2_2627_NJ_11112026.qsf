gic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"Condition","Operator":"EqualTo","RightOperand":"feedback","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> feedback <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"Language":[],"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"nofb_example","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>In another version of this task, participants receive <b>feedback<\/b> after each case: they learn whether the defendant actually reoffended, and whether their initial prediction, the model's prediction and their final prediction were correct. For example:<\/p><div style=\"text-align:center;\"><img src=\"${e:\/\/Field\/img_example_feedback}\" alt=\"Example feedback\" style=\"max-width:100%; height:auto;\"><\/div>","DataExportTag":"nofb_example","QuestionType":"DB","Selector":"TB","QuestionID":"QID49","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"Condition","Operator":"EqualTo","RightOperand":"no_feedback","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> no_feedback <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"nofb_example"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"instructions_feedback","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"border:2px solid #111; padding:10px;\"><b>Feedback:<\/b> After each case, you will learn whether the defendant actually reoffended, and whether your initial prediction, the model's prediction and your final prediction were correct.<\/p>","DataExportTag":"instructions_feedback","QuestionType":"DB","Selector":"TB","QuestionID":"QID5","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"Condition","Operator":"EqualTo","RightOperand":"feedback","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> feedback <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"instructions_feedback"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"nofb_eval","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate how much you agree with the following statements about this feedback.","DataExportTag":"nofb_eval","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":30,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"Choices":{"1":{"Display":"I would have liked to receive this feedback."},"2":{"Display":"This feedback would have helped me make better predictions."},"3":{"Display":"This feedback would have helped me learn when to rely on the model."}},"ChoiceOrder":["1","2","3"],"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"So