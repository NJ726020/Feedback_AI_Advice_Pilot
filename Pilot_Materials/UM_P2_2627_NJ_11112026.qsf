InLoop":"no","ChoiceLocator":"q:\/\/QID32\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID32","LeftOperand":"q:\/\/QID32\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> QID32 choice 2 Is Selected","Conjuction":"And"},"2":{"LogicType":"Question","QuestionID":"QID36","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID36\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID36","LeftOperand":"q:\/\/QID36\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> QID36 choice 2 Is Selected","Conjuction":"And"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"T08_fb_ic_fc"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"T08_fb_ic_fi","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align:center;\"><img src=\"${e:\/\/Field\/img_T08_fb_ic_fi}\" alt=\"Feedback\" style=\"max-width:100%; height:auto;\"><\/div>","DataExportTag":"T08_fb_ic_fi","QuestionType":"DB","Selector":"TB","QuestionID":"QID39","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"Condition","Operator":"EqualTo","RightOperand":"feedback","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> feedback <\/span>"},"1":{"LogicType":"Question","QuestionID":"QID32","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID32\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID32","LeftOperand":"q:\/\/QID32\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> QID32 choice 2 Is Selected","Conjuction":"And"},"2":{"LogicType":"Question","QuestionID":"QID36","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID36\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID36","LeftOperand":"q:\/\/QID36\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> QID36 choice 1 Is Selected","Conjuction":"And"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"T08_fb_ic_fi"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"instructions","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Your task<\/h3><p>You will see the profiles of <b>three real criminal defendants<\/b> from the United States. For each defendant, you predict whether he or she <b>reoffended within two years<\/b>.<\/p><p>Each case has three steps:<\/p><ol><li>You review the profile and make your own <b>initial prediction<\/b>.<\/li><li>You see the prediction of a <b>machine learning model<\/b> (an AI system), together with a chart explaining why the model made this prediction.<\/li><li>You make your <b>final prediction<\/b>. You can keep or change your initial prediction.<\/li><\/ol><p><b>The explanation chart<\/b> shows, for each feature of the defendant's profile, whether it <span style=\"color:#C8102E;\"><b>increases (red bars)<\/b><\/span> or <span style=\"color:#1F4FD1;\"><b>decreases (blue bars)<\/b><\/span> the defendant's chance of reoffending, according to the model. The model always compares a defendant with a reference defendant: a White female, aged 31, arrested for a misdemeanor without specific charge, with 0 prior offenses and 0 days in custody. Her chance of reoffending is low, which is shown as the <span style=\"color:#6B6B6B;\"><b>grey bar<\/b><\/span> (base rate).<\/p><p>You cannot go back to previous pages.<\/p>","DataExportTag":"instructions","QuestionType":"DB","Selector":"TB","QuestionID":"QID4","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"instructions"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID40","SecondaryAttribute":"T08_fb_ii_fc","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align:center;\"><img src=\"${e:\/\/Field\/img_T08_fb_ii_fc}\" alt=\"Feedback\" style=\"max-width:100%; height:auto;\"><\/div>","DataExportTag":"T08_fb_ii_fc","QuestionType":"DB","Selector":"TB","QuestionID":"QID40","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"Condition","Operator":"EqualTo","RightOperand":"feedback","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> feedback <\/span>"},"1":{"LogicType":"Question","QuestionID":"QID32","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID32\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID32","LeftOperand":"q:\/\/QID32\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> QID32 choice 1 Is Selected","Conjuction":"And"},"2":{"LogicType":"Question","QuestionID":"QID36","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID36\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID36","LeftOperand":"q:\/\/QID36\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> QID36 choice 2 Is Selected","Conjuction":"And"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataV