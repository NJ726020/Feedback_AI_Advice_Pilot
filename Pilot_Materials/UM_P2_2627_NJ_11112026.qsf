ibute":"QID52","SecondaryAttribute":"pref_intro","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Imagine you had to make predictions for <b>30 defendants<\/b> with the help of the model. The task could come in four versions:<\/p><ul><li>Model prediction only<\/li><li>Model prediction + explanation chart<\/li><li>Model prediction + feedback after each case<\/li><li>Model prediction + explanation chart + feedback after each case<\/li><\/ul><p><i>Feedback<\/i> means that after each case you learn the actual outcome and whether your predictions and the model's prediction were correct.<\/p>","DataExportTag":"pref_intro","QuestionType":"DB","Selector":"TB","QuestionID":"QID52","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"pref_intro"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"pref_like","TertiaryAttribute":null,"Payload":{"QuestionText":"Which version would you <b>prefer<\/b> to work with?","DataExportTag":"pref_like","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Choices":{"1":{"Display":"Model prediction only"},"2":{"Display":"Model prediction + explanation chart"},"3":{"Display":"Model prediction + feedback after each case"},"4":{"Display":"Model prediction + explanation chart + feedback after each case"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"QuestionID":"QID53","NextChoiceId":5,"NextAnswerId":1,"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"pref_like"}},{"SurveyID":"SV_57SmXSpbIXf7miq","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"pref_accuracy","TertiaryAttribute":null,"Payload":{"QuestionText":"W